# Local API configuration; values are placeholders, not credentials.
STAYLEAD_ENVIRONMENT=development
STAYLEAD_DOMAIN=hospitality
STAYLEAD_DATABASE_URL=postgresql+psycopg://staylead:change-me@localhost:5432/staylead
STAYLEAD_AI_PROVIDER=disabled
STAYLEAD_SESSION_SIGNING_SECRET=replace-with-a-random-local-secret
# Optional, development/test only. Keep the real token in an untracked local .env file.
# Format: [{"token":"<random-32-or-more-character-secret>","operator_id":"local-operator-s8","property_id":"HTL-S8-DEMO","permissions":["guide:read","guide:write"]}]
# Optional local OIDC operator. Disabled by default; enabled mode ignores bearer dev credentials.
# The issuer and OIDC endpoints are fixed server-side URLs. URLs must share the issuer origin.
# HTTPS is required. HTTP is accepted only for explicit loopback test-provider endpoints.
STAYLEAD_OPERATOR_OIDC_ENABLED=false
# STAYLEAD_OPERATOR_OIDC_ISSUER=https://issuer.example/tenant
# STAYLEAD_OPERATOR_OIDC_AUTHORIZATION_ENDPOINT=https://issuer.example/tenant/authorize
# STAYLEAD_OPERATOR_OIDC_TOKEN_ENDPOINT=https://issuer.example/tenant/token
# STAYLEAD_OPERATOR_OIDC_JWKS_URI=https://issuer.example/tenant/jwks
# STAYLEAD_OPERATOR_OIDC_CLIENT_ID=<public-client-id>
# STAYLEAD_OPERATOR_OIDC_CLIENT_SECRET=
# STAYLEAD_OPERATOR_OIDC_BROWSER_ORIGIN=https://localhost:13561
# STAYLEAD_OPERATOR_OIDC_REDIRECT_URI=https://localhost:13561/api/operator/auth/callback
# Map only an exact verified issuer|subject pair to a local role and property:
# STAYLEAD_OPERATOR_OIDC_IDENTITIES={"https://issuer.example/tenant|<subject>":{"operator_id":"local-operator","property_id":"HTL-S8-DEMO","permissions":["guide:read","guide:write"]}}
# Set true only for an isolated loopback OIDC test provider; browser origin/callback remain HTTPS.
STAYLEAD_OPERATOR_OIDC_ALLOW_LOOPBACK_HTTP=false
STAYLEAD_AI_TIMEOUT_SECONDS=25
STAYLEAD_AI_TURN_TIMEOUT_SECONDS=45
STAYLEAD_AI_MAX_OUTPUT_TOKENS=700
STAYLEAD_BOOKING_DESTINATION_BY_HOTEL={"harbor-city-demo":"https://booking.example/hotels/harbor-city-demo","lagoon-family-demo":"https://booking.example/hotels/lagoon-family-demo","pine-ridge-demo":"https://booking.example/hotels/pine-ridge-demo"}
# Optional trusted hotel contact fallback. Keep contact values public and verified.
STAYLEAD_BOOKING_CONTACT_BY_HOTEL={}
AZURE_OPENAI_BASE_URL=https://<resource-name>.services.ai.azure.com/openai/v1/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_MODEL_DEPLOYMENT=<deployment-name>
