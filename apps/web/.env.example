# Browser-visible profile metadata. Do not add credentials or private catalog data.
NEXT_PUBLIC_STAYLEAD_DOMAIN=hospitality
NEXT_PUBLIC_STAYLEAD_GUEST_CONTRACT_VERSION=2

# Server-only fixed upstream used by the same-origin guest API proxy.
STAYLEAD_API_BASE_URL=http://127.0.0.1:8000
# Required server-side redirect checks when local operator OIDC is enabled.
# STAYLEAD_OIDC_AUTHORIZATION_ENDPOINT=https://issuer.example/tenant/authorize
# STAYLEAD_OPERATOR_BROWSER_ORIGIN=https://localhost:13561
